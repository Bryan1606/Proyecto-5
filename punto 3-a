#include <iostream>
using namespace std;

int tarifa=4000;

struct carro{
    string placa;
    float Hingreso;
    float Hsalida;
    float valor;
};
struct tarifa
{
   int Ntarifa;
};
int main()
{
    int opcion;
    int acumuladora=0;
    carro listacarros[40];
    
    cout<<"Bienvenidos a mi app \n";
    cout<<"La tarifa del parqueadero por hora es de $4000 \n \n";
    cout<<"Seleccione una opción: \n \n";

    do {
        cout<<"\n1. Ingresar un carro al parqueadero. \n2. Dar salida a un carro. \n3. Mostrar total de dinero. \n4. Mostrar cupos disponibles \n5. Mostrar porcentaje de cupos disponibles \n6. Ingresar nueva hora del parqueadero \n7. Salir\n";
        cin>>opcion;

        switch(opcion)
        {
            case 1:
                if(acumuladora>=40){
                    cout<<"Limite de cupos alcanzado";
                }
                else{
                    cout<<"Ingresa la información del carro: \n";
                    cout<<"Placa del carro: ";
                    cin>>listacarros[acumuladora].placa;
                    cout<<"Hora de entrada: ";
                    cin>>listacarros[acumuladora].Hingreso;
                    acumuladora++;
                }
                break;

            case 2:
                string placaSolicitada;
                cout<<"\nDigite la placa del carro que va a dar salida: \n";
                cin>>placaSolicitada;
                int aux = -1;
                for(int x=0; x<acumuladora; x++){
                    if(listacarros[x].placa==placaSolicitada){
                        aux = x;
                        break;
                    }
                }

                cout<<"Digite la hora de salida: \n";
                cin>>listacarros[aux].Hsalida;

                if(aux!=-1){
                    cout<<"Placa del carro: "<<listacarros[aux].placa<<"\n";
                    cout<<"Hora de entrada: "<<listacarros[aux].Hingreso<<"\n";
                    cout<<"Hora de salida: "<<listacarros[aux].Hsalida<<"\n";
                    cout<<"Valor a pagar: ";
                    listacarros[aux].valor=tarifa*(listacarros[aux].Hsalida - listacarros[aux].Hingreso);
                    cout<<listacarros[aux].valor<<"\n";
                }
                else {
                    cout<<"La placa que solicito no fue encontrada\n";
                }
                break;

            case 3:
                cout<<"Mostrar total de dinero\n";
                break;

            case 4:
                cout<<"Mostrar cupos disponibles\n";
                break;

            case 5:
                cout<<"Mostrar porcentaje de cupos disponibles\n";
                break;

            case 6:
                cout<<"Ingresar nueva hora del parqueadero\n";
                cin >> Ntarifa;
                tarifa=Ntarifa
                cout << "Nueva tarifa por hora: "<<Ntarifa;
                break;

            case 7:
                cout<<"Salir";
                break;

            default:
                cout<<"inválida";
                break;
        }

    } while(opcion!=7);
}
